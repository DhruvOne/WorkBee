<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background">

    <!-- Circle background containing the asset icon -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_circle_yellow"
        android:layout_marginBottom="40dp">

        <ImageView
            android:id="@+id/img_slide"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_workbee_logo"
            android:contentDescription="@string/app_name" />
    </FrameLayout>

    <TextView
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find Expert Help"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/secondary"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txt_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Browse verified local professionals for plumbing, electrical, cleaning, and more instantly."
        android:textSize="15sp"
        android:textColor="@color/grey_600"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
