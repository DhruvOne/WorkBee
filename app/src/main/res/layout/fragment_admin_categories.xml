<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/layout_admin_cat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service Category Manager"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/secondary"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure categories and default base service pricing"
            android:textSize="13sp"
            android:textColor="@color/grey_600"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

    <!-- Categories List Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_admin_categories"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_admin_cat_header"
        android:scrollbars="vertical" />

    <!-- Add Category Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add Category"
        app:backgroundTint="@color/primary"
        app:tint="@color/secondary"
        app:fabSize="normal"
        app:elevation="6dp" />

</RelativeLayout>
