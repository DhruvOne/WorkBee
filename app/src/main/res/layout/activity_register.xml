<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Decorative Dashed flight trails filling background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_login_dashed_trail"
        android:scaleType="fitXY"
        android:alpha="0.8" />

    <!-- Top Left decorative wrench honeycomb outline -->
    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/bg_honeycomb_wrench"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="80dp" />

    <!-- Top Right decorative plug honeycomb outline -->
    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/bg_honeycomb_plug"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="60dp" />

    <!-- Bottom Left decorative bee -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐝"
        android:textSize="20sp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="58dp"
        android:layout_marginBottom="90dp" />

    <!-- Bottom yellow wave accent -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:src="@drawable/bg_login_bottom_wave"
        android:scaleType="fitXY"
        android:layout_alignParentBottom="true" />

    <!-- Scrollable container for register content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="90dp">

            <!-- Hexagonal mascot logo frame -->
            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_workbee_logo"
                android:layout_marginTop="16dp" />

            <!-- Title: Join WorkBee -->
            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/txt_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign up to stay connected with WorkBee"
                android:textColor="#A0A0A0"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Segmented Role Selector -->
            <RadioGroup
                android:id="@+id/rg_role"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_segmented_selector"
                android:layout_marginTop="20dp"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/rb_customer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_btn_left"
                    android:button="@null"
                    android:checked="true"
                    android:text="Customer / User"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <RadioButton
                    android:id="@+id/rb_provider"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_btn_right"
                    android:button="@null"
                    android:text="Worker / Provider"
                    android:textStyle="bold"
                    android:textColor="#A0A0A0"
                    android:gravity="center" />
            </RadioGroup>

            <!-- Inputs container card -->
            <LinearLayout
                android:id="@+id/card_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_login_card"
                android:padding="20dp"
                android:layout_marginTop="20dp">

                <!-- Full Name Field -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_register_user"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edt_fullname"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_login_input"
                    android:hint="Enter your full name"
                    android:textColorHint="#4E4E4E"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:paddingHorizontal="14dp"
                    android:inputType="textPersonName"
                    android:singleLine="true" />

                <!-- Email Field -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_login_email"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edt_email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_login_input"
                    android:hint="Enter your email address"
                    android:textColorHint="#4E4E4E"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:paddingHorizontal="14dp"
                    android:inputType="textEmailAddress"
                    android:singleLine="true" />

                <!-- Phone Field -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_register_phone"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edt_phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_login_input"
                    android:hint="Enter your phone number"
                    android:textColorHint="#4E4E4E"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:paddingHorizontal="14dp"
                    android:inputType="phone"
                    android:singleLine="true" />

                <!-- Phone Verification OTP Section -->
                <LinearLayout
                    android:id="@+id/layout_reg_phone_verification_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_verify_reg_phone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="#FFC107"
                        android:text="Verify Number with OTP"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <!-- Reg OTP Input Container -->
                    <LinearLayout
                        android:id="@+id/layout_reg_otp_verification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/edt_reg_otp"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/selector_login_input"
                            android:hint="Enter 6-digit OTP"
                            android:textColorHint="#4E4E4E"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:paddingHorizontal="10dp"
                            android:inputType="number"
                            android:maxLength="6"
                            android:singleLine="true" />

                        <Button
                            android:id="@+id/btn_verify_reg_otp"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="0.8"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="#FFC107"
                            android:text="Verify"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </LinearLayout>

                    <!-- Green verified badge -->
                    <TextView
                        android:id="@+id/txt_phone_verified_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verified ✅"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Dynamic Provider Fields Container -->
                <LinearLayout
                    android:id="@+id/layout_provider_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍯 SPECIALIST PROFILE DETAILS"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:textColor="#FFC107"
                        android:layout_marginBottom="12dp" />

                    <!-- Business Name -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_register_user"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Business / Brand Name"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edt_business"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/selector_login_input"
                        android:hint="e.g. Elena's Elite Cleaning"
                        android:textColorHint="#4E4E4E"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true" />

                    <!-- Service Category Dropdown -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Category"
                        android:textSize="12sp"
                        android:textColor="#80FFFFFF"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="4dp" />
                    
                    <Spinner
                        android:id="@+id/spin_category"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner" />

                    <!-- Experience and Hourly Rate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Experience (Yrs)"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/edt_experience"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/selector_login_input"
                                android:hint="e.g. 5"
                                android:textColorHint="#4E4E4E"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:paddingHorizontal="14dp"
                                android:inputType="number"
                                android:singleLine="true" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rate (₹/Hr)"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <EditText
                                android:id="@+id/edt_rate"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/selector_login_input"
                                android:hint="e.g. 35.00"
                                android:textColorHint="#4E4E4E"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:paddingHorizontal="14dp"
                                android:inputType="numberDecimal"
                                android:singleLine="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tier Guide Link -->
                    <TextView
                        android:id="@+id/btn_tier_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐝 What is my classification tier &amp; rate guide?"
                        android:textColor="#FFC107"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground" />

                    <!-- Short Bio -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Business Bio / Bio Info"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/edt_bio"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@drawable/selector_login_input"
                        android:hint="Tell clients about your specialty skills..."
                        android:textColorHint="#4E4E4E"
                        android:textColor="@color/white"
                        android:textSize="13.5sp"
                        android:padding="12dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical" />

                </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_password_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Password field section -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_login_lock"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Password"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp">

                            <EditText
                                android:id="@+id/edt_password"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/selector_login_input"
                                android:hint="Create password"
                                android:textColorHint="#4E4E4E"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:paddingStart="14dp"
                                android:paddingEnd="46dp"
                                android:inputType="textPassword"
                                android:singleLine="true" />

                            <ImageButton
                                android:id="@+id/btn_password_toggle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="6dp"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_login_eye"
                                android:contentDescription="Toggle Password Visibility" />
                        </RelativeLayout>

                        <!-- Confirm Password field section -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_login_lock"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Confirm Password"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp">

                            <EditText
                                android:id="@+id/edt_confirm_password"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/selector_login_input"
                                android:hint="Re-enter password"
                                android:textColorHint="#4E4E4E"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:paddingStart="14dp"
                                android:paddingEnd="46dp"
                                android:inputType="textPassword"
                                android:singleLine="true" />

                            <ImageButton
                                android:id="@+id/btn_confirm_password_toggle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="6dp"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_login_eye"
                                android:contentDescription="Toggle Confirm Password Visibility" />
                        </RelativeLayout>

                    </LinearLayout>

                <!-- Register Button FrameLayout Container -->
                <FrameLayout
                    android:id="@+id/btn_register"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_login_button"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Sign Up"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="18dp"
                        android:src="@drawable/ic_arrow_right" />
                </FrameLayout>

            </LinearLayout>

            <!-- Already have account Link -->
            <TextView
                android:id="@+id/txt_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? Sign In"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
