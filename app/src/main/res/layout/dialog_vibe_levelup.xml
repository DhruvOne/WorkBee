<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/transparent">

    <!-- Top Drag indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#20FFFFFF"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:strokeWidth="2dp"
        app:strokeColor="#FFC107"
        app:cardBackgroundColor="#0D0D0D">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Decorative background trails representing confetti -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_login_dashed_trail"
                android:scaleType="fitXY"
                android:alpha="0.2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ MILESTONE COMPLETED! ✨"
                    android:textColor="#FFC107"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Glow celebration star emoji -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="64sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIBE LEVEL-UP!"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You reached Level 5 Honeycomb Elite Pro status!"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:gravity="center" />

                <!-- Dividers -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#20FFFFFF"
                    android:layout_marginVertical="16dp" />

                <!-- Unlocked perks decks -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNLOCKED ELITE PERKS:"
                    android:textColor="#FFC107"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:layout_gravity="start"
                    android:layout_marginBottom="12dp" />

                <!-- Perk 1: Earnings Multiplier -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="16sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Base Earnings Multiplier: 1.1x boost!"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Perk 2: Priority Dispatch Matching -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛰️"
                        android:textSize="16sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Priority Vibe Dispatch priority matching"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Perk 3: Hexagonal Icon Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨"
                        android:textSize="16sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gold Hexagon Premium profile outline unlocked"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dismiss Button CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_levelup_dismiss"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="LET'S GET IT! 🚀"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginTop="20dp"
        app:backgroundTint="#FFC107"
        app:cornerRadius="12dp" />

</LinearLayout>
