<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.workbee.app">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Background location: keeps GPS running when screen is off (Zomato/Uber style) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Required to start a foreground service for location tracking -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="replace" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="replace" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_workbee_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_workbee_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorkBee"
        android:usesCleartextTraffic="true">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDummyKeyWorkBee2026GoogleMaps" />

        <!-- Splash Screen Activity (Launcher) -->
        <activity
            android:name=".ui.common.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.WorkBee">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Screen -->
        <activity
            android:name=".ui.common.OnboardingActivity"
            android:exported="false" />

        <!-- Authentication Activities -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Customer Domain Activities -->
        <activity
            android:name=".ui.customer.CustomerMainActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.customer.CategoriesActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.customer.ProviderListActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.customer.ProviderDetailsActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.customer.BookingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.UberMatchActivity"
            android:exported="false" />
        
        <activity
            android:name=".ui.customer.ReviewsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.customer.BeeAiHubActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ✦ NEW: Customer Live Tracking Activity -->
        <activity
            android:name=".ui.customer.CustomerTrackingActivity"
            android:exported="false"
            android:label="Live Tracking" />

        <!-- Service Provider Activities -->
        <activity
            android:name=".ui.provider.ProviderMainActivity"
            android:exported="false" />

        <!-- ✦ NEW: Worker Navigation / Tracking Activity -->
        <activity
            android:name=".ui.provider.WorkerTrackingActivity"
            android:exported="false"
            android:label="Navigate to Customer" />

        <!-- Admin Activities -->
        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false" />

        <!-- ✦ NEW: Background GPS Foreground Service -->
        <service
            android:name=".utils.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>

