<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Customer Name -->
            <TextView
                android:id="@+id/txt_req_customer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sarah Jenkins"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/secondary" />

            <!-- Price -->
            <TextView
                android:id="@+id/txt_req_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="₹108.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />
        </RelativeLayout>

        <!-- Service Details & Address -->
        <TextView
            android:id="@+id/txt_req_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kitchen sink pipe is dripping water. Needs quick repair."
            android:textSize="13sp"
            android:textColor="@color/grey_800"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txt_req_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="456 Blossom Lane, Tech City"
            android:textSize="11sp"
            android:textColor="@color/grey_600"
            android:layout_marginTop="6dp"
            android:drawableStart="@android:drawable/ic_menu_mylocation"
            android:drawablePadding="4dp" />

        <!-- Date & Slot details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_req_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date: May 24, 2026"
                    android:textSize="11sp"
                    android:textColor="@color/grey_600"
                    android:drawableStart="@android:drawable/ic_menu_today"
                    android:drawablePadding="4dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/txt_req_slot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slot: 10:00 AM"
                    android:textSize="11sp"
                    android:textColor="@color/grey_600"
                    android:drawableStart="@android:drawable/ic_menu_recent_history"
                    android:drawablePadding="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_req_payment_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment: Cash on Service"
                android:textSize="11sp"
                android:textColor="@color/grey_600"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:drawablePadding="4dp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_100"
            android:layout_marginVertical="12dp" />

        <!-- Accept / Reject Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reject"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Decline Request"
                android:textColor="@color/status_cancelled"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_accept"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Accept Service"
                android:backgroundTint="@color/status_completed"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
