<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:importantForAutofill="noExcludeDescendants">

    <!-- Language Selector Floating Button -->
    <ImageButton
        android:id="@+id/btn_change_language"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_circle_yellow"
        android:src="@android:drawable/ic_menu_mapmode"
        android:contentDescription="Change Language"
        android:elevation="6dp" />

    <!-- Decorative Dashed flight trails filling background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_login_dashed_trail"
        android:scaleType="fitXY"
        android:alpha="0.8" />

    <!-- Top Left decorative wrench honeycomb outline -->
    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/bg_honeycomb_wrench"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="100dp" />

    <!-- Top Right decorative plug honeycomb outline -->
    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/bg_honeycomb_plug"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="80dp" />

    <!-- Bottom Left decorative bee at end of flight trail -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐝"
        android:textSize="20sp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="58dp"
        android:layout_marginBottom="90dp" />

    <!-- Bottom yellow wave accent aligned to absolute bottom -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:src="@drawable/bg_login_bottom_wave"
        android:scaleType="fitXY"
        android:layout_alignParentBottom="true" />

    <!-- Scrollable container for login content to support smaller devices -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="90dp">

            <!-- Hexagonal mascot logo frame -->
            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:src="@drawable/ic_workbee_logo"
                android:layout_marginTop="20dp" />

            <!-- Title: Welcome Back -->
            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/txt_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to stay connected with WorkBee"
                android:textColor="#A0A0A0"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <!-- Segmented Role Selector -->
            <RadioGroup
                android:id="@+id/rg_login_role"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_segmented_selector"
                android:layout_marginTop="20dp"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/rb_login_customer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_btn_left"
                    android:button="@null"
                    android:checked="true"
                    android:text="Customer / User"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <RadioButton
                    android:id="@+id/rb_login_provider"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_btn_right"
                    android:button="@null"
                    android:text="Worker / Provider"
                    android:textStyle="bold"
                    android:textColor="#A0A0A0"
                    android:gravity="center" />
            </RadioGroup>

            <!-- Inputs container card -->
            <LinearLayout
                android:id="@+id/card_inputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_login_card"
                android:padding="20dp"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:id="@+id/layout_email_login_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Email field section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_login_email"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email Address"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edt_login_field_usr"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/selector_login_input"
                        android:hint="Enter your email"
                        android:textColorHint="#4E4E4E"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:inputType="textEmailAddress"
                        android:importantForAutofill="no"
                        android:singleLine="true" />

                    <!-- Password field section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_login_lock"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Password"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp">

                        <EditText
                            android:id="@+id/edt_login_field_pwd"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/selector_login_input"
                            android:hint="Enter your password"
                            android:textColorHint="#4E4E4E"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="46dp"
                            android:inputType="textPassword"
                            android:importantForAutofill="no"
                            android:singleLine="true" />

                        <!-- Eye toggle icon -->
                        <ImageButton
                            android:id="@+id/btn_password_toggle"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="6dp"
                            android:background="@android:color/transparent"
                            android:src="@drawable/ic_login_eye"
                            android:contentDescription="Toggle Password Visibility" />
                    </RelativeLayout>

                    <!-- Forgot Password -->
                    <TextView
                        android:id="@+id/txt_forgot_pwd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot Password?"
                        android:textColor="#FFC107"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:padding="4dp" />

                    <!-- Login Button Container -->
                    <FrameLayout
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_login_button"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Sign In"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="18dp"
                            android:src="@drawable/ic_arrow_right" />
                    </FrameLayout>

                </LinearLayout>

                <!-- Worker OTP Login Fields -->
                <LinearLayout
                    android:id="@+id/layout_worker_otp_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Phone Field Label -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_register_phone"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone Number"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Phone Number Input & Send OTP Button in a row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp">
                        <EditText
                            android:id="@+id/edt_worker_phone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/selector_login_input"
                            android:hint="Enter phone number"
                            android:textColorHint="#4E4E4E"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="120dp"
                            android:inputType="phone"
                            android:singleLine="true" />
                        <Button
                            android:id="@+id/btn_send_otp"
                            android:layout_width="110dp"
                            android:layout_height="match_parent"
                            android:layout_margin="3dp"
                            android:layout_alignParentEnd="true"
                            android:backgroundTint="#FFC107"
                            android:text="Send OTP"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp" />
                    </RelativeLayout>

                    <!-- OTP Code Verification Section (Initially GONE) -->
                    <LinearLayout
                        android:id="@+id/layout_otp_verification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_login_lock"
                                android:layout_marginEnd="8dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Verification Code (OTP)"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/edt_otp_code"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/selector_login_input"
                            android:hint="Enter 6-digit OTP"
                            android:textColorHint="#4E4E4E"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:inputType="number"
                            android:maxLength="6"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/txt_otp_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FFC107"
                            android:textSize="12sp"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp" />

                        <!-- Verify OTP Button -->
                        <FrameLayout
                            android:id="@+id/btn_verify_otp"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_login_button"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Verify &amp; Sign In"
                                android:textColor="@color/black"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="18dp"
                                android:src="@drawable/ic_arrow_right" />
                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- OR Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="24dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#20FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" OR "
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="16dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#20FFFFFF" />
            </LinearLayout>

            <!-- Google Sign-In Container Button -->
            <FrameLayout
                android:id="@+id/btn_google"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_google_button"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_google_logo"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continue with Google"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Register Link -->
            <TextView
                android:id="@+id/txt_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? Register"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
