<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Profile Bar Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/img_profile"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/txt_welcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello, Sarah Jenkins! 👋"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/txt_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 456 Blossom Lane, Tech City"
                        android:textSize="12.5sp"
                        android:textColor="#A0A0A0"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical" />
                </LinearLayout>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/img_profile"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_workbee_logo"
                    app:civ_border_width="2dp"
                    app:civ_border_color="#FFC107" />

            </RelativeLayout>

            <!-- Slogan Card (Vibrant Yellow and Black design) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_bee_visual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#FFC107"
                app:cardBackgroundColor="#0C0C0C"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toStartOf="@id/img_illustration"
                        android:layout_alignParentStart="true"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Get 20% Off"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFC107" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="On your first home cleaning booking today!"
                            android:textSize="12.5sp"
                            android:textColor="#80FFFFFF"
                            android:layout_marginTop="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_offer_book"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="✨ Book Cleaner  >"
                            android:textSize="11.5sp"
                            android:textColor="@color/black"
                            android:backgroundTint="#FFC107"
                            android:textStyle="bold"
                            android:layout_marginTop="14dp"
                            android:paddingVertical="0dp"
                            android:paddingHorizontal="14dp"
                            app:cornerRadius="20dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/img_illustration"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_workbee_logo" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar + Separate Filter Button Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <!-- Rounded Search Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="14dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#20FFFFFF"
                    app:cardBackgroundColor="#121212">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="#FFC107" />

                        <EditText
                            android:id="@+id/edt_search"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:background="@null"
                            android:hint="Search plumber, cleaner, electrician..."
                            android:textColorHint="#5E5E5E"
                            android:textColor="@color/white"
                            android:textSize="13.5sp"
                            android:singleLine="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Outlined Filter Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    app:cardCornerRadius="14dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#FFC107"
                    app:cardBackgroundColor="#121212">

                    <ImageButton
                        android:id="@+id/btn_filter_home"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="#FFC107"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Filter Services" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Categories Section Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categories"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/txt_view_all_cats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="View all &gt;"
                    android:textColor="#FFC107"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Categories Grid RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3" />



        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_bee_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="Ask BeeAI 🐝"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_btn_speak_now"
        app:iconTint="@color/black"
        app:backgroundTint="#FFC107"
        app:elevation="6dp" />

</RelativeLayout>
