<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/transparent">

    <!-- Top Drag Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#20FFFFFF"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#FFC107"
        app:cardBackgroundColor="#0D0D0D">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍯 Honey HP Reward Store 🍯"
                android:textColor="#FFC107"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Win premium custom coupons by scratching cards!"
                android:textColor="#80FFFFFF"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp"
                android:gravity="center" />

            <!-- Milestone Progress Meter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0AFFFFFF"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Honeycomb Elite (Lvl 3)"
                        android:textColor="@color/white"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="750 / 1000 HP"
                        android:textColor="#FFC107"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progress="75"
                    android:progressTint="#FFC107"
                    android:progressBackgroundTint="#20FFFFFF" />
            </LinearLayout>

            <!-- INTERACTIVE SCRATCH CARD DECK CONTAINER -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp">

                <!-- Behind Layout: Revealed Code Panel -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layout_coupon_revealed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#FFC107"
                    app:cardBackgroundColor="#121212">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎉 Scratch Card Win! 🎉"
                            android:textColor="#FFC107"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_revealed_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BEESCRATCH30"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:background="#20FFFFFF"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30% OFF next home cleaning service • Copied to clipboard! 📋"
                            android:textColor="#80FFFFFF"
                            android:textSize="10.5sp"
                            android:layout_marginTop="6dp"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Front Layout: Mystery Scratch Cover Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_scratch_deck"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="#FFC107"
                    app:cardBackgroundColor="#FFC107"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Glowing Hexagon Overlay Graphic -->
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_login_dashed_trail"
                            android:scaleType="fitXY"
                            android:alpha="0.2" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_centerInParent="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🍯"
                                android:textSize="32sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SCRATCH TO WIN ✨"
                                android:textColor="@color/black"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Taps / rubs to swipe card cover"
                                android:textColor="#B0000000"
                                android:textSize="10sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next scratch unlocks at 1,000 HP milestone"
                android:textColor="#6E6E6E"
                android:textSize="11sp"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dismiss Button CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/scratch_btn_dismiss"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Close Store 🚀"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginTop="20dp"
        app:backgroundTint="#FFC107"
        app:cornerRadius="12dp" />

</LinearLayout>
