<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Toolbar back navigation row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_yellow"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/txt_booking_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Service"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/secondary"
                android:layout_centerInParent="true" />
        </RelativeLayout>

        <!-- Related Issues Selection Section -->
        <TextView
            android:id="@+id/txt_issues_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Related Issue"
            android:textStyle="bold"
            android:textColor="@color/secondary"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#20FFFFFF"
            app:cardBackgroundColor="@color/surface">

            <RadioGroup
                android:id="@+id/rg_issues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/issue_option_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pipe Leakage (Est. ₹300.00)"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:paddingVertical="8dp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/issue_option_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Broken Tap (Est. ₹150.00)"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/issue_option_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Water Tank Issue (Est. ₹800.00)"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:paddingVertical="8dp" />

                <RadioButton
                    android:id="@+id/issue_option_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Other (Describe Below)"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:paddingVertical="8dp" />

            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- Date Selector Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Date"
            android:textStyle="bold"
            android:textColor="@color/secondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <DatePicker
            android:id="@+id/date_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:datePickerMode="calendar"
            android:calendarViewShown="false"
            android:background="@color/surface"
            android:elevation="2dp" />

        <!-- BeeSmart Scheduler AI Advice -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_bee_scheduler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#FFC107"
            app:cardBackgroundColor="#0B0B0B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐝 📅"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BeeSmart Scheduler AI"
                        android:textColor="#FFC107"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_scheduler_vibe_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analyzing weather and provider schedule availability..."
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_apply_scheduler_vibe"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Auto-Apply GOAT Time Slot ✨"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="11.5sp"
                    app:backgroundTint="#FFC107"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Time Slots Horizontal Picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Time Slots"
            android:textStyle="bold"
            android:textColor="@color/secondary"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <!-- Segmented horizontal selections -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <RadioGroup
                android:id="@+id/rg_time_slots"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/slot1"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:button="@null"
                    android:checked="true"
                    android:background="@drawable/selector_booking_slot"
                    android:text="09:00 AM - 11:00 AM"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/slot2"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:button="@null"
                    android:background="@drawable/selector_booking_slot"
                    android:text="11:00 AM - 01:00 PM"
                    android:textColor="@color/grey_600"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/slot3"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:button="@null"
                    android:background="@drawable/selector_booking_slot"
                    android:text="01:00 PM - 03:00 PM"
                    android:textColor="@color/grey_600"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/slot4"
                    android:layout_width="160dp"
                    android:layout_height="match_parent"
                    android:button="@null"
                    android:background="@drawable/selector_booking_slot"
                    android:text="03:00 PM - 05:00 PM"
                    android:textColor="@color/grey_600"
                    android:textStyle="bold"
                    android:gravity="center" />

            </RadioGroup>
        </HorizontalScrollView>

        <!-- Service Details Inputs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/service_details"
            android:textStyle="bold"
            android:textColor="@color/secondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/describe_problem_hint"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="3"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Location Address -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/service_address_hint"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/primary"
            app:startIconDrawable="@android:drawable/ic_menu_mylocation">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Payment Option Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Method"
            android:textStyle="bold"
            android:textColor="@color/secondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Cash on Service Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pay_cash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/primary"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txt_pay_cash_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💵"
                        android:textSize="24sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txt_pay_cash_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Pay Online Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pay_online"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:strokeColor="@color/primary"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txt_pay_online_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💳"
                        android:textSize="24sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txt_pay_online_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online"
                        android:textColor="@color/grey_600"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Wallet Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_pay_wallet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:strokeColor="@color/primary"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txt_pay_wallet_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🪙"
                        android:textSize="24sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txt_pay_wallet_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wallet"
                        android:textColor="@color/grey_600"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Promo Coupon Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFC107"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎫 Promo Coupon &amp; Discount"
                    android:textStyle="bold"
                    android:textColor="#FFC107"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/edt_promo_code"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_login_input"
                        android:hint="Coupon (WELCOME100 / BEEGOLD)"
                        android:textColorHint="#4E4E4E"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="textCapCharacters"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btn_apply_promo"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#FFC107"
                        android:text="Apply"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_promo_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Promo applied successfully!"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pricing Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price_summary"
                    android:textStyle="bold"
                    android:textColor="@color/secondary"
                    android:layout_marginBottom="12dp" />

                <!-- Job rate summary -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hourly Base Rate"
                        android:textColor="@color/grey_600" />

                    <TextView
                        android:id="@+id/txt_base_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="₹49.00 / hr"
                        android:textColor="@color/secondary"
                        android:textStyle="bold" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimated duration (min job)"
                        android:textColor="@color/grey_600" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="2 Hours"
                        android:textColor="@color/secondary"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Service Fee -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/service_fee"
                        android:textColor="@color/grey_600" />

                    <TextView
                        android:id="@+id/txt_service_fee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="₹9.80"
                        android:textColor="@color/secondary"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Discount Row -->
                <RelativeLayout
                    android:id="@+id/layout_discount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txt_discount_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Promo Discount"
                        android:textColor="#4CAF50"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_discount_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="-₹0.00"
                        android:textColor="#4CAF50"
                        android:textStyle="bold" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/grey_100"
                    android:layout_marginBottom="12dp" />

                <!-- Total -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_price"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary" />

                    <TextView
                        android:id="@+id/txt_total_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="₹107.80"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark" />
                </RelativeLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Book Action Button -->
        <Button
            android:id="@+id/btn_confirm_booking"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/confirm_booking"
            android:backgroundTint="@color/primary"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>
