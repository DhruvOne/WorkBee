<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/grey_100"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Category header -->
            <TextView
                android:id="@+id/txt_job_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plumbing Repair"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/secondary" />

            <!-- Price right -->
            <TextView
                android:id="@+id/txt_job_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="₹108.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/secondary" />
        </RelativeLayout>

        <!-- Customer Name -->
        <TextView
            android:id="@+id/txt_job_customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer: Sarah Jenkins"
            android:textSize="13sp"
            android:textColor="@color/grey_800"
            android:layout_marginTop="4dp" />

        <!-- Job Description/Instructions -->
        <TextView
            android:id="@+id/txt_job_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kitchen sink pipe is dripping water. Needs quick repair."
            android:textSize="12sp"
            android:textColor="@color/grey_600"
            android:layout_marginTop="6dp" />

        <!-- Address -->
        <TextView
            android:id="@+id/txt_job_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="456 Blossom Lane, Tech City"
            android:textSize="11sp"
            android:textColor="@color/grey_600"
            android:layout_marginTop="6dp"
            android:drawableStart="@android:drawable/ic_menu_mylocation"
            android:drawablePadding="4dp" />

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_100"
            android:layout_marginVertical="12dp" />

        <!-- Date & Slot details -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/txt_job_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date: May 24, 2026"
                    android:textSize="11sp"
                    android:textColor="@color/grey_600"
                    android:drawableStart="@android:drawable/ic_menu_today"
                    android:drawablePadding="6dp" />

                <TextView
                    android:id="@+id/txt_job_slot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slot: 10:00 AM - 12:00 PM"
                    android:textSize="11sp"
                    android:textColor="@color/grey_600"
                    android:drawableStart="@android:drawable/ic_menu_recent_history"
                    android:drawablePadding="6dp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txt_job_payment_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment: Cash on Service"
                    android:textSize="11sp"
                    android:textColor="@color/grey_600"
                    android:drawableStart="@android:drawable/ic_menu_info_details"
                    android:drawablePadding="6dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Colored pill representing status -->
            <TextView
                android:id="@+id/txt_job_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_status_completed"
                android:text="COMPLETED"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

        </RelativeLayout>

        <!-- Action Subtitle description for next stage -->
        <TextView
            android:id="@+id/txt_job_action_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Stage: Drive to customer's location"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="italic"
            android:layout_marginTop="8dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Action Button for job completion -->
        <Button
            android:id="@+id/btn_action_job"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Mark Job Completed"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/status_completed"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cornerRadius="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
